# ============================================================
# ScaleBiometrics Web — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# NextAuth.js
AUTH_SECRET=your-secret-here-min-32-chars
AUTH_URL=http://localhost:3000

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=scalebiometrics
KEYCLOAK_CLIENT_ID=scalebiometrics-web
KEYCLOAK_CLIENT_SECRET=

# Backend API
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public Keycloak config (exposed to browser)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=scalebiometrics
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=scalebiometrics-web
