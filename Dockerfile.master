# Multi-stage build for ScaleBiometrics Master Orchestrator

# Stage 1: Build (using Debian-based image for better tool support)
FROM maven:3.9-eclipse-temurin-21 AS build

# Install protobuf compiler (required for gRPC code generation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy entire project structure (all modules required by parent POM)
COPY pom.xml .
COPY packages packages
COPY apps apps

# Build the Master module with all dependencies
RUN mvn clean package -DskipTests -B -pl apps/master -am

# Stage 2: Runtime (lightweight Alpine image)
FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="ScaleBiometrics Team"
LABEL description="ScaleBiometrics Master Orchestrator - Distributed orchestration service"

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

WORKDIR /app

# Copy JAR from build stage
COPY --from=build /build/apps/master/target/master-*.jar app.jar

# Change ownership
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose ports
EXPOSE 8082 9092

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8082/api/actuator/health || exit 1

# Run application with Virtual Threads enabled
ENTRYPOINT ["java", \
            "-XX:+UseZGC", \
            "-XX:+UseStringDeduplication", \
            "-Xms512m", \
            "-Xmx2g", \
            "-Djava.security.egd=file:/dev/./urandom", \
            "-jar", \
            "app.jar"]
